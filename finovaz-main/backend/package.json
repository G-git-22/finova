{
  "name": "@finova/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify TypeScript in-memory financial engine, REST routes, and demo generator",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "generate:pdfs": "ts-node src/scripts/generatePdfs.ts"
  },
  "dependencies": {
    "@finova/shared": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
