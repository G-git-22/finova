{
  "name": "finovaz-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FINOVAZ - Autonomous Agentic Supply Chain Financing Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "npm run dev --workspaces --parallel",
    "start": "npm run start --workspace=backend",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "supply-chain-finance",
    "topsis",
    "cryptography",
    "fastify",
    "react",
    "vite",
    "fintech"
  ],
  "author": "FINOVA Principal Engineering Team",
  "license": "MIT"
}
